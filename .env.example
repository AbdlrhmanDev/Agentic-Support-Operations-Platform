# Copy to .env and adjust. Never commit .env.

# Local default matches docker-compose.yml (Postgres published on 5434).
DATABASE_URL=postgresql+psycopg://support:support@localhost:5434/support_ops

# Model. LLM_PROVIDER is openai or anthropic; LLM_MODEL must be one of that provider's models.
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-6.1-sol
LLM_EFFORT=medium
# Optional model routing: short tickets that ask for no action go to this model.
# LLM_LIGHT_MODEL=gpt-6-luna

# Policy search embeddings: hashing (offline, deterministic) or openai.
# Run `uv run python -m app.seed` again after changing either value.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small

# When set, every API route except /health needs this value in the X-API-Key header.
API_KEY=
# Reviewer name -> personal key, as JSON. When set, only these keys can decide an
# approval and the reviewer recorded is the key's owner.
# REVIEWER_KEYS={"dana":"change-me","eli":"change-me-too"}

# Business limits (USD).
AUTO_REFUND_THRESHOLD=100.00
MAX_REFUND_AMOUNT=1000.00
REFUND_WINDOW_DAYS=30
LOST_SHIPMENT_DAYS=10
AUTO_REPLACEMENT_THRESHOLD=150.00

# Approval queue order: waiting longer than the SLA is urgent, a large amount is high.
APPROVAL_SLA_MINUTES=60
HIGH_VALUE_APPROVAL_AMOUNT=500.00

# Agent loop limits.
MAX_AGENT_STEPS=12
MAX_CONSECUTIVE_TOOL_FAILURES=3

# none | console
OTEL_EXPORTER=none

# Testing only: lets API callers make tools fail on purpose.
ALLOW_FAULT_INJECTION=false
